{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "node": "22.14.0",
      "env": {
        "RCT_USE_PREBUILT_RNCORE": "0"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "22.14.0",
      "env": {
        "RCT_USE_PREBUILT_RNCORE": "0"
      }
    },
    "production": {
      "node": "22.14.0",
      "autoIncrement": true,
      "env": {
        "RCT_USE_PREBUILT_RNCORE": "0",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}